{
  // `include` below only matches files that exist once scripts/generate-icons.mjs
  // (Task 30) and playwright.config.ts / e2e/**/*.ts (Task 32) land — before
  // that, TypeScript hard-errors (TS18003) on a referenced project with zero
  // matched input files, which would break `npm run typecheck`/`npm run build`
  // (both run `tsc -b`). Both files now exist, so tsconfig.json's "references"
  // array includes { "path": "./tsconfig.node.json" } (restored, not omitted) —
  // see src/__tests__/projectConfig.test.ts, which asserts that wiring stays in
  // place once either input exists.
  "compilerOptions": {
    "target": "ES2022",
    // DOM (+ Iterable) is here for e2e/**/*.ts only: Playwright specs run
    // `page.evaluate(...)` callbacks that reference real browser globals
    // (`indexedDB`, `document`, `navigator`, `window`) — those callbacks are
    // still ordinary TypeScript, type-checked against THIS project's lib, even
    // though they execute inside the browser page rather than this Node
    // process. scripts/generate-icons.mjs is plain JS (see `allowJs` below) and
    // unaffected either way.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // scripts/generate-icons.mjs is plain JS, not TS — without this, the
    // `.mjs` glob in `include` below matches zero recognized input files
    // (TypeScript only counts .ts/.tsx/.d.ts as inputs unless allowJs is on),
    // which reproduces the exact TS18003 "no inputs" error this file's
    // comment above describes. `checkJs` stays off (the default): the .mjs
    // file is included as a build input so referencing it doesn't error, but
    // its contents aren't type-checked.
    "allowJs": true
  },
  "include": ["scripts/**/*.mjs", "playwright.config.ts", "e2e/**/*.ts"]
}
